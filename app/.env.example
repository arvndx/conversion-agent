# Copy this file to .env (in the same folder) and fill in the values.
# .env holds secrets and is never committed. Do not paste real keys into any other file.

# Anthropic API key for the agent's real model. Set it when we switch from the stand-in model.
ANTHROPIC_API_KEY=

# Local Postgres (the output database).
DATABASE_URL=postgresql://localhost:5432/conversion_agent

# Local Redis (live chats and bundles). Not running yet.
REDIS_URL=redis://localhost:6379/0

# Length of an abuse block, in minutes. 60 in production; 3 for testing (A73).
BLOCK_MINUTES=60
