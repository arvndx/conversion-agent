{
  "tools": [
    {
      "name": "get_business_info",
      "description": "Read a fact or link the business has on record, for example opening hours, phone, email, address, service area, services, parking, offers, or a link such as booking_link or menu_link. Use it before saying something is not on record. If it returns found false, say it is not on record and offer to pass the question on. Never guess.",
      "inputs": {
        "type": "object",
        "required": [
          "field"
        ],
        "properties": {
          "field": {
            "type": "string",
            "description": "The fact to read. The allowed names are filled in from the business's data when the chat starts."
          }
        }
      }
    },
    {
      "name": "request_handoff",
      "description": "Open a request form for the visitor and pass the request to the business when they submit it. Use it when the visitor wants to book, schedule, request something, get a quote or talk to a person, and when the information they want is not on record. Give the action_key of what they want (direct_handover when none fits). The form asks for the details, so do not ask the visitor for them. Put in prefill only what the visitor already said in this chat. After you call it the visitor sees the form and you write nothing more. Never say a request was sent or booked: the visitor sends it by submitting the form.",
      "inputs": {
        "type": "object",
        "required": [
          "action_key"
        ],
        "properties": {
          "action_key": {
            "type": "string",
            "description": "The action the visitor wants, or direct_handover when none fits."
          },
          "reason": {
            "type": "string",
            "enum": [
              "visitor_asked",
              "not_on_record",
              "unsure"
            ],
            "description": "Why: visitor_asked (they asked for it or for a person), not_on_record (the answer is not on record), unsure (the question is unclear)."
          },
          "prefill": {
            "type": "object",
            "description": "Only values the visitor already gave in this chat. Leave out anything they did not say.",
            "properties": {
              "name": {
                "type": "string",
                "title": "Your name",
                "format": "name",
                "maxLength": 60,
                "description": "So the business knows who to contact."
              },
              "phone": {
                "type": "string",
                "title": "Phone number",
                "format": "phone",
                "maxLength": 20,
                "description": "So the business can call you. Give a phone number or an email."
              },
              "email": {
                "type": "string",
                "title": "Email",
                "format": "email",
                "maxLength": 120,
                "description": "So the business can write to you. Give a phone number or an email."
              },
              "question": {
                "type": "string",
                "title": "Your request",
                "format": "text",
                "maxLength": 500,
                "description": "What you would like, in your own words.",
                "minLength": 3
              },
              "date": {
                "type": "string",
                "title": "Preferred date",
                "format": "date",
                "description": "The day you would like, as a date."
              },
              "time": {
                "type": "string",
                "title": "Preferred time",
                "format": "time",
                "description": "The time you would like, as hours and minutes."
              },
              "note": {
                "type": "string",
                "title": "Anything else",
                "format": "text",
                "maxLength": 300,
                "description": "Anything else the business should know."
              }
            }
          }
        }
      }
    }
  ],
