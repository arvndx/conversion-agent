DATABASE_URL=postgresql+psycopg://clearrank:clearrank@localhost:5432/clearrank
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-sonnet-5
AGENT_MAX_TOOL_ROUNDS=6
AGENT_WEB_SEARCH_MAX_USES=3
AGENT_HTTP_TIMEOUT_SECONDS=8
# Optional LangGraph tracing via Langfuse (v4). Tracing is off unless both keys are set.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
# Demo behaviour: wipe and reseed all data every time the backend starts. Set false to keep data.
RESET_ON_STARTUP=true
# Live scraping through Oxylabs (same variable names as the v2-gamification job). Optional: without all
# four, blocked sites are rendered in the browser directly and Cloudflare-protected sites stay blocked.
OXYLAB_USER=
OXYLAB_PASSWORD=
OXYLAB_HOST=
OXYLAB_PORT=
SCRAPE_CONCURRENCY=4
SCRAPE_TIMEOUT_SECONDS=45
# Sessions and OTP. Change SECRET_KEY outside local dev. DEMO_MODE adds the "Viewing as" account switcher
# and a no-code demo sign-in; turn it off anywhere real data lives.
SECRET_KEY=dev-only-secret-change-me
DEMO_MODE=true
SESSION_DAYS=7
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
